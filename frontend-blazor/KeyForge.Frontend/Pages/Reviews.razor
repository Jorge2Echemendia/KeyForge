        new Testimonio { nombre = "Patricia Morales", cargo = "Diseñadora UX", avatar = "https://i.pravatar.cc/150?img=10",
texto = "Después de probar 5 teclados diferentes, me quedé con KeyForge. La ergonomía y la personalización son insuperables." }
    };

    private double GetPorcentaje(int estrellas)
    {
        var dict = new Dictionary<int, double> { { 5, 78 }, { 4, 15 }, { 3, 4 }, { 2, 2 }, { 1, 1 } };
        return dict.TryGetValue(estrellas, out var valor) ? valor : 0;
    }

    private void HoverReview(int id) { /* Podrías agregar lógica de hover aquí si quisieras */ }
    private void LeaveReview(int id) { }

    private readonly string[] _opcionesOrden  ={
"Más Recientes","Mejor Valoradas" ,"Peor Valoradas"};
}