        new Review { id = 1, nombre = "Carlos Mendoza", avatar = "https://i.pravatar.cc/150?img=11", fecha = "15 Ago 2024",
rating = 5, verified = true, titulo = "¡El mejor teclado que he tenido!", comentario = "Llevo 3 meses con el KeyForge Alpha y es increíble. Los switches Cherry MX Red son súper suaves y el RGB es personalizable al 100%.", producto =
"KeyForge Alpha", utiles = 45, imagenes = new List<string> {
"https://images.unsplash.com/photo-1595225476474-87563907a212?w=200" } },
        new Review { id = 2, nombre = "Ana Rodríguez", avatar = "https://i.pravatar.cc/150?img=5", fecha = "10 Ago 2024", rating
