@using MudBlazor
<MudNavMenu>


    <MudDivider Class="my-2" />
    <!-- Menú de Navegación -->

    <MudNavLink Href="https://jorge2echemendia.github.io/KeyForge/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @if (IsExpanded)
        {
            <span>Inicio</span>
        }
    </MudNavLink>
    <MudNavLink Href="/KeyForge/shop" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">
        @if (IsExpanded)
        {
            <span>Tienda</span>
        }
        <MudBadge Content="6" Color="Color.Primary" Overlap="true" Class="ml-1" />
    </MudNavLink>
    <MudNavLink Href="/KeyForge/reviews" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Reviews">
        @if (IsExpanded)
        {
            <span>Reseñas</span>
        }
    </MudNavLink>
    <MudNavLink Href="/KeyForge/contact" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Contacts">
        @if (IsExpanded)
        {
            <span>Contacto</span>
        }
    </MudNavLink>
    <MudText Typo="Typo.caption" Class="px-4 mt-2 mb-1" Color="Color.Secondary">
        @if (IsExpanded)
        {
            <span>CUENTA </span>
        }
    </MudText>
    <MudNavLink Href="/KeyForge/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Login">
        @if (IsExpanded)
        {
            <span>Iniciar Sesión</span>
        }
    </MudNavLink>
    <MudNavLink Href="/KeyForge/register" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.PersonAdd">
        @if (IsExpanded)
        {
            <span>Registrarse</span>
        }
    </MudNavLink>

    
    <!-- Footer del Drawer -->
    @if (IsExpanded)
    {
        <div class="drawer-footer mt-auto pa-4">
            <MudPaper Elevation="0" Class="pa-3 rounded-lg" Style="background: var(--mud-palette-background);">
                <MudText Typo="Typo.caption" Class="mb-2">¿Necesitas ayuda?</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                           Href="/contact">
                    Contactar Soporte
                </MudButton>
            </MudPaper>
        </div>
    }

</MudNavMenu>

@code {
    [Parameter] public bool IsExpanded { get; set; } = true;
}